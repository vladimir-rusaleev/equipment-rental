{
  "uid": "rent-overview",
  "title": "Rent — обзор сервисов",
  "tags": [
    "rent"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Доступность сервисов: 1 — метрики доступны",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "rent-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"gateway|rental|inventory|notifier\"}",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "rent-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Запросы HTTP / секунду",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rent-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rent_http_requests_total[$__rate_interval])) or vector(0)",
          "legendFormat": "Gateway",
          "datasource": {
            "type": "prometheus",
            "uid": "rent-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Время ответа HTTP — p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rent-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rent_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "rent-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Запросы gRPC / секунду",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rent-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(rent_grpc_requests_total[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "rent-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Ошибки / секунду",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rent-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rent_http_requests_total{code=~\"[45]..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "HTTP 4xx / 5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "rent-prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (job) (rate(rent_grpc_requests_total{code!=\"OK\"}[$__rate_interval]))",
          "legendFormat": "gRPC {{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "rent-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "События в очередях",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rent-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rent_queue_pending",
          "legendFormat": "{{job}} / {{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "rent-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Попытки обработки уведомлений / секунду",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rent-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, result) (rate(rent_notification_attempts_total[$__rate_interval]))",
          "legendFormat": "{{stage}} / {{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "rent-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
