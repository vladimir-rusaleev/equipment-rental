SERVICE_KEY=local-development-key-change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

STORAGE=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change-postgres-owner-password
APP_DB_PASSWORD=change-services-database-password
SEED_DEMO=true

# Monitoring (Docker Compose)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Local binaries use gRPC by default; Compose uses Kafka.
NOTIFICATION_TRANSPORT=grpc
KAFKA_BROKERS=127.0.0.1:19092
KAFKA_PORT=19092
KAFKA_TOPIC=rental.orders
KAFKA_GROUP=rent-notifier
